# Not loaded automatically: export these in your shell before starting app.py.
PORT=5000
# Concurrent CDS downloads (each job is one fetcher process)
MAX_JOBS=2
# Where job folders are written (default: ./downloads)
# DOWNLOADS_DIR=
# Where the device catalogue is read from (default: ./devices)
# DEVICES_DIR=
# Comma-separated extra hostnames to allow (default: 127.0.0.1, localhost, [::1])
# ALLOWED_HOSTS=
